# Node (docx generator)
node_modules/

# Generated PDF (regenerable)
CAHIER_DES_CHARGES_MY_HOME_CI.pdf

# ── Secrets et configuration locale ──────────────────────────────────────
# Le keystore et ses mots de passe ne doivent jamais quitter la machine.
android/key.properties
*.jks
*.keystore
android/local.properties

# Clefs de service Firebase (Admin SDK) — donnent un acces total au projet.
**/serviceAccountKey.json
**/*-firebase-adminsdk-*.json

# Dependances et artefacts des Cloud Functions
functions/node_modules/
functions/.env
functions/.env.*
!functions/.env.example

# Sorties de build iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# Clef Google Maps iOS injectee au build (Codemagic) ou en local. Ne jamais
# versionner : elle contient MAPS_API_KEY_IOS.
ios/Flutter/Keys.xcconfig
